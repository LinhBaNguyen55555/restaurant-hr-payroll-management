# Copy to backend/.env for local use, or set these in the process environment.
# For an HTTPS deployment with schema validation, also set SPRING_PROFILES_ACTIVE=mysql.
DB_URL=jdbc:mysql://localhost:3306/restaurant_hr_payroll_management
DB_USER=restaurant_app
DB_PASSWORD=
# Base64-encoded 32 random bytes. Keep this stable and back it up separately from the database.
MFA_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
